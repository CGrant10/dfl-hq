{
  "name": "dfl-hq",
  "version": "1.394.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "release:check": "node tools/check-release-version.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "names": "node tools/check-names.mjs",
    "test": "vitest run",
    "build": "node tools/build-shared-css.mjs && vite build --config vite.trade.config.js && vite build",
    "check": "pnpm release:check && pnpm typecheck && pnpm names && pnpm test && pnpm build"
  },
  "dependencies": {
    "pixi.js": "^8.20.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}

